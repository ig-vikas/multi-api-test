# OpenCode Zen API tester
# Copy these values into .env, then replace XXXX with your OpenCode Zen key.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_TEST_MESSAGE=hii
OPENCODE_MAX_TOKENS=64
OPENCODE_MODELS=minimax-m3-free,mimo-v2.5-free,nemotron-3-super-free,nemotron-3-ultra-free,qwen3.6-plus-free,deepseek-v4-flash-free
